# GEI Discovery Guide — environment variables
# Copy to .env.local for local development. NEVER commit real values.
# On Vercel: Project → Settings → Environment Variables.

# --- PayPal (same app/credential names as the existing GEI checkout) -------
# live | sandbox. Use sandbox for end-to-end payment testing.
PAYPAL_ENV=sandbox
# Public client id (also used by the browser PayPal SDK — not a secret).
PAYPAL_CLIENT_ID=
# Server-only. Never expose.
PAYPAL_CLIENT_SECRET=
# Id of the webhook registered for https://<domain>/api/webhooks/paypal
# (PayPal Developer Dashboard → your app → Webhooks). Each webhook URL has its own id.
PAYPAL_WEBHOOK_ID=

# --- Entitlement store (Upstash Redis / Vercel KV, shared GEI infrastructure)
# Either the Upstash names or the Vercel KV names work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# redis (default, required on Vercel) | file | memory (local dev / tests only)
# ENTITLEMENT_STORE=file
# ENTITLEMENT_STORE_FILE=.data/store.json

# --- Account sessions -----------------------------------------------------
# HMAC key for the signed account cookie. 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating it signs every customer out (their access is kept; they restore with an access key).
ENTITLEMENT_SESSION_SECRET=

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
